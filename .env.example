# ---- App secrets ----
INVITE_CODE=replace-me-with-a-shared-code
ADMIN_API_TOKEN=replace-me-with-a-long-random-string
SESSION_SECRET=replace-me-32-bytes-hex

# Single admin account bootstrapped on first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Creator (VA) account bootstrapped on first start. The VA logs in here to
# upload clips and watch their review status. Leave CREATOR_USERNAME blank
# to disable the creator account entirely.
CREATOR_USERNAME=VirtualAsst
CREATOR_PASSWORD=

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Drive ----
# Service account JSON inline OR file path. Pick one.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Four-folder model. Create four folders in Drive, share all four with the
# service account's client_email (Editor), and paste their IDs here.
DRIVE_PENDING_FOLDER_ID=
DRIVE_APPROVED_FOLDER_ID=
DRIVE_TRASH_FOLDER_ID=
DRIVE_POSTED_FOLDER_ID=

# Days a rejected clip is kept before it's auto-deleted (Drive file + row).
# 0 = never auto-delete.
TRASH_RETENTION_DAYS=14

# ---- Gemini captions ----
# Used to generate a social caption + hashtags when a video is approved.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to a current Gemini flash model.
GEMINI_MODEL=gemini-2.5-flash
# Optional. Overrides the brand-voice instructions for caption generation.
CAPTION_BRAND_PROMPT=
# Optional. Call-to-action appended to every caption (e.g.
# "📞 Call <Brand> at <phone>"). Empty by default — no CTA appended.
CAPTION_CTA=

# ---- Cloudflare Stream (video delivery / CDN) ----
# Clips are copied to Cloudflare Stream on ingest and played from the CDN
# instead of being proxied through this server. Leave blank to disable
# (the app falls back to proxying from Drive).
# Account ID: Cloudflare dashboard → Stream. Token: My Profile → API
# Tokens → Create, with the Stream:Edit permission.
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=

# ---- Web Push notifications ----
# Generate a key pair once with:  npx web-push generate-vapid-keys
# Leave blank to disable push (the in-app bell still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Server ----
PORT=3000

# ---------------------------------------------------------------------------
# Marketing site (site/) — teamrajjaggi.com. Independent of the video app.
# Nothing below is required to boot; unset CINC vars disable those pathways.
# ---------------------------------------------------------------------------

SITE_PORT=4000
# Protects /cinc/connect, /api/cinc/health, /api/leads/recent.
SITE_ADMIN_TOKEN=
SITE_BASE_URL=https://www.teamrajjaggi.com
SITE_GA_ID=
SITE_META_PIXEL_ID=

# Brand overrides (defaults live in site/config.js)
# SITE_BRAND_NAME=Team Raj Jaggi
# SITE_PHONE=(516) 996-3633
# SITE_EMAIL=info@teamrajjaggi.com
# No brokerage affiliation is displayed anywhere unless this is set.
# SITE_BROKERAGE=
# Logo paths are auto-detected from site/public/images/logo.* — set these only
# to point somewhere else. SITE_LOGO_LIGHT is the knockout for the dark footer.
# SITE_LOGO=/images/logo.png
# SITE_LOGO_LIGHT=/images/logo-light.png

# --- CINC pathway 1: IDX handoff -------------------------------------------
# The team's CINC-hosted IDX site. Set this and all search, neighborhood, and
# listing links hand off to CINC, where its registration gate captures leads.
CINC_IDX_BASE_URL=
CINC_IDX_SEARCH_PATH=/results-gallery
CINC_IDX_LISTING_PATH=/listing
CINC_IDX_VALUATION_PATH=/home-valuation

# --- CINC pathway 2: Open API lead capture ---------------------------------
# Every site form upserts into the CINC CRM via POST /v2/site/leads.
CINC_CLIENT_ID=
CINC_CLIENT_SECRET=
# 'client_credentials' (default) or 'refresh_token'. For refresh_token, run the
# one-time handshake at /cinc/connect?token=<SITE_ADMIN_TOKEN> and paste the
# token printed in the server log below.
CINC_GRANT_TYPE=
CINC_REFRESH_TOKEN=
CINC_REDIRECT_URI=https://www.teamrajjaggi.com/cinc/callback
CINC_SCOPE=api:create api:read api:update
# Tags every website lead so CINC routing rules can branch on it.
CINC_DEFAULT_TAGS=website
CINC_DEFAULT_SOURCE=teamrajjaggi.com
# Optional: route all website leads to one CINC user.
CINC_ASSIGNED_AGENT_ID=
# Verifies x-cinc-signature on POST /api/cinc/webhook.
CINC_WEBHOOK_SECRET=
CINC_DEBUG=false

# --- Lead handling ----------------------------------------------------------
# Optional mirror to Zapier / n8n / Make, HMAC-signed when a secret is set.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
LEAD_RATE_LIMIT_PER_HOUR=20
