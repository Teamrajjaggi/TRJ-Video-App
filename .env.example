# Copy to .env and fill in.

# ---- required ----
# Invite code required for /signup. Anyone with this code can create a user.
INVITE_CODE=replace-me-with-a-shared-code

# Bearer token for the machine API (n8n -> /api/admin/*). Generate a long random string.
ADMIN_API_TOKEN=replace-me-with-a-long-random-string

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-32-bytes-hex

# ---- Higgsfield video generation ----
# Paste your Higgsfield credentials here. Without them, the generator
# falls back to a sample-video stub so the rest of the loop still works.
HIGGSFIELD_API_KEY=
HIGGSFIELD_KEY_ID=

# Auth scheme. We don't know which one Higgsfield actually expects, so
# try the default first; if it 401s, set this to one of:
#   bearer            -> Authorization: Bearer <api-key>
#   bearer-with-id    -> Bearer + hf-api-key/hf-key-id headers (default)
#   basic             -> Authorization: Basic base64(<key-id>:<api-key>)
#   x-api-key         -> X-API-Key + X-Key-Id headers
# HIGGSFIELD_AUTH_MODE=bearer-with-id

# Optional Higgsfield overrides — leave defaults unless you know you need them.
# HIGGSFIELD_BASE_URL=https://fnf.higgsfield.ai
# HIGGSFIELD_SUBMIT_PATH=/jobs/v2/kling3_0
# HIGGSFIELD_STATUS_PATH=/jobs/{id}
# HIGGSFIELD_DURATION=5
# HIGGSFIELD_ASPECT=9:16
# HIGGSFIELD_RESOLUTION=720p
# HIGGSFIELD_POLL_INTERVAL=4000
# HIGGSFIELD_TIMEOUT_MS=600000
# HIGGSFIELD_DISABLED=1   # set to skip the API entirely (forces the stub)

# ---- optional ----
# Override the bootstrapped admin password. If unset, a random one prints on first start.
# ADMIN_PASSWORD=

# Google Drive vault for liked videos. Service account JSON (inline) and the destination folder ID.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or point to a file path instead:
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# VAULT_DRIVE_FOLDER_ID=

# Server port (default 3000)
# PORT=3000
