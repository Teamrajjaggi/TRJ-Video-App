# Copy to .env and fill in.

# ---- required ----
# Invite code required for /signup. Anyone with this code can create a user.
INVITE_CODE=replace-me-with-a-shared-code

# Bearer token for the machine API (n8n -> /api/admin/*). Generate a long random string.
ADMIN_API_TOKEN=replace-me-with-a-long-random-string

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-32-bytes-hex

# ---- Image generation: Google Gemini Nano Banana ----
# Required. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Primary image model. Default is nano-banana-pro-preview (Gemini 3 Pro Image).
# GEMINI_IMAGE_MODEL=nano-banana-pro-preview
#
# Fallback model used only if the primary 5xx/429s after retries. Imagen 4
# uses a different capacity pool than Nano Banana, so an outage on one
# doesn't take down the other. Set to "" to disable fallback (will stub
# instead). Imagen doesn't accept reference images.
# GEMINI_FALLBACK_MODEL=imagen-4.0-fast-generate-001
#
# Retries on the primary model before falling back. 3 attempts × backoff
# = ~21 seconds before the fallback kicks in.
# GEMINI_MAX_RETRIES=3
# GEMINI_BACKOFF_MS=3000
# GEMINI_DISABLED=1  # forces the stub fallback even if the key is set

# ---- Video animation: Higgsfield DoP turbo ----
# Paste both Higgsfield credentials from cloud.higgsfield.ai. Without
# them, the generator falls back to a sample-video stub so the rest of
# the loop still works.
HIGGSFIELD_API_KEY=
HIGGSFIELD_KEY_ID=

# Subject identity. These never live in source control — only here.
# Reference image URLs are passed directly into Gemini for identity lock.
SUBJECT_A_NAME=
SUBJECT_B_NAME=
SUBJECT_A_REFERENCE=
SUBJECT_B_REFERENCE=

# Optional Higgsfield overrides. Defaults: DoP turbo (image-to-video).
# Other DoP variants: lite | standard | turbo | *-first-last-frame.
# HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
# HIGGSFIELD_VIDEO_MODEL=higgsfield-ai/dop/turbo
# HIGGSFIELD_CRED_ORDER=id-first    # "id-first" or "key-first" if 401s
# HIGGSFIELD_DURATION=5
# HIGGSFIELD_ASPECT=9:16
# HIGGSFIELD_RESOLUTION=720p
# HIGGSFIELD_POLL_INTERVAL=4000
# HIGGSFIELD_TIMEOUT_MS=900000
# HIGGSFIELD_DISABLED=1   # set to skip the API entirely (forces the stub)

# ---- optional ----
# Override the bootstrapped admin password. If unset, a random one prints on first start.
# ADMIN_PASSWORD=

# Cloudflare R2 vault for liked videos (S3-compatible).
# Without these, likes still save to data/saved-vault/ locally so the loop
# keeps working — you just won't have public URLs for social posting yet.
#
# Create at https://dash.cloudflare.com → R2 → "Create bucket".
# Then: R2 → Manage R2 API Tokens → "Create API Token" (Object Read & Write).
# Then: bucket → Settings → enable a public R2.dev URL OR connect a custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---- Google Drive video source (optional) ----
# Lets the app pull videos from a shared Drive folder into the feed.
# Setup: create a Google Cloud service account, enable Drive API, download
# the JSON key, then share your Drive folder with the service account's
# client_email (Viewer access). Copy the folder id from the Drive URL.
#
# Either inline the JSON, or set GOOGLE_SERVICE_ACCOUNT_FILE to a path:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_FILE=C:\Users\you\drive-sa.json
DRIVE_FOLDER_ID=

# Auto-sync the Drive folder into the feed every N minutes. Set to 0 to
# disable (then the Sync Drive button is the only path).
# DRIVE_SYNC_INTERVAL_MINUTES=15

# ---- Database ----
# SQLite file location. Default: data/app.db
# On Railway, point at a path inside the mounted volume, e.g. /data/app.db.
# DB_PATH=/data/app.db

# Server port (default 3000)
# PORT=3000
